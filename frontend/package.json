{
  "name": "developer-tools-frontend",
  "version": "1.0.0",
  "private": true,
  "bin": {
    "devstools": "scripts/devstools-cli.mjs"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "cross-env PLAYWRIGHT_USE_PRODUCTION_SERVER=true playwright test",
    "test:e2e:headed": "cross-env PLAYWRIGHT_USE_PRODUCTION_SERVER=true playwright test --headed",
    "audit:seo": "node scripts/seo-geo-audit.mjs",
    "submit:indexnow": "node scripts/submit-indexnow.mjs",
    "analyze": "cross-env ANALYZE=true next build --webpack",
    "audit:security": "npm audit --audit-level=high && npm audit --omit=dev --audit-level=moderate",
    "build:extension": "node scripts/generate-extension-catalog.mjs && node scripts/package-extension.mjs",
    "cli": "node scripts/devstools-cli.mjs",
    "check": "npm run lint && npm run type-check && npm run test",
    "check:all": "npm run check && npm run test:e2e"
  },
  "dependencies": {
    "@peculiar/x509": "^2.1.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@wordlist/english-eff": "^1.0.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "csso": "^5.0.5",
    "dompurify": "^3.4.15",
    "js-yaml": "^5.4.2",
    "lucide-react": "^1.47.0",
    "marked": "^18.0.13",
    "next": "^16.3.6",
    "nodemailer": "^10.0.10",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "reflect-metadata": "^0.2.2",
    "sql-formatter": "^15.8.2",
    "terser": "^5.51.2",
    "ua-parser-js": "2.0.10"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@next/bundle-analyzer": "^16.3.5",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/csso": "^5.0.5",
    "@types/node": "^26.6.2",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ua-parser-js": "0.7.39",
    "autoprefixer": "10.6.1",
    "cross-env": "^10.1.0",
    "eslint": "10.11.0",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.0",
    "postcss": "8.5.28",
    "prettier": "^3.9.8",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.26"
    }
  }
}
