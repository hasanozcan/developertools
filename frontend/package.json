{
  "name": "developer-tools-frontend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:seo": "node scripts/seo-geo-audit.mjs",
    "submit:indexnow": "node scripts/submit-indexnow.mjs",
    "analyze": "cross-env ANALYZE=true next build --webpack",
    "audit:security": "npm audit --audit-level=high && npm audit --omit=dev --audit-level=moderate",
    "check": "npm run lint && npm run type-check && npm run test"
  },
  "dependencies": {
    "@wordlist/english-eff": "^1.0.1",
    "@vercel/analytics": "^1.6.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.12",
    "js-yaml": "^5.2.1",
    "lucide-react": "^0.400.0",
    "marked": "^12.0.0",
    "next": "^16.2.10",
    "nodemailer": "^9.0.3",
    "qrcode": "^1.5.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sql-formatter": "^15.8.2",
    "ua-parser-js": "1.0.41"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.10",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^7.0.12",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/ua-parser-js": "0.7.39",
    "autoprefixer": "10.5.2",
    "cross-env": "^10.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "postcss": "8.5.17",
    "prettier": "^3.9.5",
    "tailwindcss": "3.4.19",
    "typescript": "5.4.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.17"
    }
  }
}
