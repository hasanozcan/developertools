# Production Environment Variables for Netlify
# Add these in Netlify Dashboard > Site Settings > Environment Variables

# Site URL (your Netlify domain or custom domain)
NEXT_PUBLIC_SITE_URL=https://devstools.app

# Backend API URL (deployed backend URL)
NEXT_PUBLIC_API_URL=https://developertools.onrender.com/api

# Google AdSense Publisher ID
NEXT_PUBLIC_ADSENSE_ID=ca-pub-7506836211914310

# Google Search Console Verification
NEXT_PUBLIC_GOOGLE_VERIFICATION=2zgaMJ_vjuwPzrd5IxAF8qyOLIkETkGmHgKkHgMdrEc

# Google Analytics ID (optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Backend API URL for redirects (used in netlify.toml)
BACKEND_API_URL=https://developertools.onrender.com/api
