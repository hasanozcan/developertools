# Frontend Environment Variables
# Copy this file to .env.local and update values

# Site URL (used for canonical URLs, sitemap, meta tags, and structured data)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Organization.sameAs profiles for structured data (comma-separated, https only).
# Emitted only when set, so the schema never advertises an empty list.
NEXT_PUBLIC_SOCIAL_PROFILES=

# Backend API URL (optional)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Google Search Console Verification
# Get this from: https://search.google.com/search-console (HTML tag verification code)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# Bing Webmaster & Yandex Webmaster Verification (Optional)
NEXT_PUBLIC_BING_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=

# Google AdSense Publisher ID
# Get your ID from: https://adsense.google.com
NEXT_PUBLIC_ADSENSE_ID=ca-pub-xxxxxxxxxxxxxxxx

# Google AdSense ad unit slot IDs (digits only)
# Dedicated slot IDs let AdSense reports distinguish each placement.
NEXT_PUBLIC_ADSENSE_LEFT_SLOT=
NEXT_PUBLIC_ADSENSE_RIGHT_SLOT=
NEXT_PUBLIC_ADSENSE_SIDEBAR_SLOT=
NEXT_PUBLIC_ADSENSE_FOOTER_SLOT=
# Tool page only. Create a dedicated slot for each; they stay hidden while empty
# instead of falling back to NEXT_PUBLIC_ADSENSE_FOOTER_SLOT.
NEXT_PUBLIC_ADSENSE_TOOL_BOTTOM_SLOT=
NEXT_PUBLIC_ADSENSE_TOOL_ZEN_BOTTOM_SLOT=
# Optional extra placements. Each stays hidden until it has a unit id of its own.
# Tool pages: one unit inside the answer content, shown below the lg breakpoint only.
NEXT_PUBLIC_ADSENSE_TOOL_INCONTENT_SLOT=
# Category pages: in-feed unit after every 12th tool card.
NEXT_PUBLIC_ADSENSE_CATEGORY_INFEED_SLOT=
# Optional ad formats (auto, fluid, rectangle, vertical, horizontal). Unset keeps the
# current format. "auto" lets Google serve rectangles as well, to compare revenue.
NEXT_PUBLIC_ADSENSE_SIDEBAR_FORMAT=
NEXT_PUBLIC_ADSENSE_POST_TOOL_FORMAT=
# Placements that share a unit id today. Set their own ids to compare them in reports;
# empty keeps the id they already use.
NEXT_PUBLIC_ADSENSE_HOME_INFEED_SLOT=
NEXT_PUBLIC_ADSENSE_HOME_AFTER_TOOLS_SLOT=
NEXT_PUBLIC_ADSENSE_HOME_BEFORE_SEO_SLOT=
NEXT_PUBLIC_ADSENSE_CATEGORY_TOP_SLOT=
NEXT_PUBLIC_ADSENSE_COLLECTION_INDEX_SLOT=6442607030
NEXT_PUBLIC_ADSENSE_COLLECTION_TOP_SLOT=6416143146
NEXT_PUBLIC_ADSENSE_COLLECTION_BOTTOM_SLOT=2103906771

# Google Ads Conversion ID (gtag)
# Format example: AW-XXXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Google Ads conversion event settings
NEXT_PUBLIC_GOOGLE_ADS_SEND_TO=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_VALUE=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_CURRENCY=

# Google Analytics ID (optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Contact form SMTP (Gmail/Outlook/etc.)
CONTACT_TO_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Optional custom from header (falls back to SMTP_USER)
# SMTP_FROM="DevsTools <you@example.com>"
